{
  "name": "react-govrs-ds",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "sideEffects": ["*.css", "*.scss"],
  "main": "./dist/react-govrs-ds.cjs",
  "module": "./dist/react-govrs-ds.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/react-govrs-ds.es.js",
      "require": "./dist/react-govrs-ds.cjs",
      "types": "./dist/types/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "style": "./dist/style.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:types": "tsc --project tsconfig.lib.json --emitDeclarationOnly",
    "build": "npm run build:types && vite build",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sass": "^1.83.1",
    "sass-embedded": "^1.97.3",
    "storybook": "^8.6.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^5.4.21"
  }
}
