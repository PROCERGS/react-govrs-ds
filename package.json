{
  "name": "@procergs/react-govrs-ds",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./dist/foundation.js",
    "./dist/foundation.cjs",
    "./dist/tokens.js",
    "./dist/tokens.cjs"
  ],
  "main": "./dist/react-govrs-ds.es.js",
  "module": "./dist/react-govrs-ds.es.js",
  "browser": "./dist/react-govrs-ds.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/react-govrs-ds.es.js",
      "import": "./dist/react-govrs-ds.es.js",
      "require": "./dist/react-govrs-ds.cjs",
      "default": "./dist/react-govrs-ds.es.js"
    },
    "./foundation": {
      "types": "./dist/types/foundation.d.ts",
      "browser": "./dist/foundation.js",
      "import": "./dist/foundation.js",
      "require": "./dist/foundation.cjs",
      "default": "./dist/foundation.js"
    },
    "./tokens": {
      "types": "./dist/types/runtime-tokens.d.ts",
      "browser": "./dist/tokens.js",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs",
      "default": "./dist/tokens.js"
    },
    "./components/*": "./dist/components/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006 --initial-path /docs/apresentacao--page",
    "storybook": "storybook dev -p 6006 --initial-path /docs/apresentacao--page",
    "build-storybook": "storybook build",
    "build:types": "tsc --project tsconfig.lib.json --emitDeclarationOnly",
    "build": "vite build && npm run build:types",
    "prepack": "npm run build",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sass": "^1.83.1",
    "sass-embedded": "^1.97.3",
    "storybook": "^8.6.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@react-google-maps/api": "^2.16.1"
  }
}
