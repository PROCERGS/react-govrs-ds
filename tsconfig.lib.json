{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "./src",
    "declaration": true,
    "declarationDir": "./dist/types",
    "emitDeclarationOnly": true,
    "stripInternal": true
  },
  "include": ["src"],
  "exclude": [
    ".storybook/**/*",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/**/*.story.ts",
    "src/**/*.story.tsx",
    "src/**/*.stories.mdx",
    "src/**/*.story.mdx"
  ]
}
